# Copy to `.env` for local dev. NOT required for Vercel deploy —
# the app defaults to the same-deploy serverless proxy (/api/dramabox-proxy).
# Only set these if you want to keep using the old Supabase edge function.

# VITE_SUPABASE_URL=https://<project>.supabase.co
# VITE_SUPABASE_PROJECT_ID=<project>
# VITE_SUPABASE_PUBLISHABLE_KEY=<anon key>

# Or point the drama-API proxy at any compatible base explicitly:
# VITE_PROXY_BASE=/api/dramabox-proxy
