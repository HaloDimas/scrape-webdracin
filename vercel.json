{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/classic/api/:path*",
      "destination": "/api/:path*"
    },
    { "source": "/search", "destination": "/index.html" },
    { "source": "/favorites", "destination": "/index.html" },
    { "source": "/history", "destination": "/index.html" },
    { "source": "/more", "destination": "/index.html" },
    { "source": "/dracin", "destination": "/index.html" },
    { "source": "/dracin/:path*", "destination": "/index.html" },
    { "source": "/drama/:path*", "destination": "/index.html" },
    { "source": "/watch/:path*", "destination": "/index.html" },
    { "source": "/privacy", "destination": "/index.html" },
    { "source": "/terms", "destination": "/index.html" },
    { "source": "/dmca", "destination": "/index.html" },
    { "source": "/contact", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/classic/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600" }]
    }
  ]
}
