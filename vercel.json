{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/classic/api/:path*",
      "destination": "/api/wd/:path*"
    },
    { "source": "/api/health", "destination": "/api/wd/health" },
    { "source": "/api/cache-clear", "destination": "/api/wd/cache-clear" },
    { "source": "/api/platforms", "destination": "/api/wd/platforms" },
    { "source": "/api/platform-status", "destination": "/api/wd/platform-status" },
    { "source": "/api/list", "destination": "/api/wd/list" },
    { "source": "/api/all", "destination": "/api/wd/all" },
    { "source": "/api/search", "destination": "/api/wd/search" },
    { "source": "/api/drama", "destination": "/api/wd/drama" },
    { "source": "/api/watch", "destination": "/api/wd/watch" },
    { "source": "/api/episode", "destination": "/api/wd/episode" },
    { "source": "/api/full", "destination": "/api/wd/full" },
    { "source": "/api/proxy", "destination": "/api/wd/proxy" },
    { "source": "/api/img", "destination": "/api/wd/img" },
    { "source": "/search", "destination": "/index.html" },
    { "source": "/favorites", "destination": "/index.html" },
    { "source": "/history", "destination": "/index.html" },
    { "source": "/more", "destination": "/index.html" },
    { "source": "/dracin", "destination": "/index.html" },
    { "source": "/dracin/:path*", "destination": "/index.html" },
    { "source": "/drama/:path*", "destination": "/index.html" },
    { "source": "/watch/:path*", "destination": "/index.html" },
    { "source": "/privacy", "destination": "/index.html" },
    { "source": "/terms", "destination": "/index.html" },
    { "source": "/dmca", "destination": "/index.html" },
    { "source": "/contact", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/classic/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600" }]
    }
  ]
}
